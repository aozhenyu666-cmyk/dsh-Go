{
  "name": "dsh-go-partner",
  "version": "0.1.0",
  "private": true,
  "description": "R4 人格/记忆/情绪的原生界面层：心情条、心情/记忆/目的三面板、remember 工具卡。数据来自 dsh-fish-memory 与 dsh-feiyu-mood，本包只读不改。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./views": "./lib/views.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "views"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "伙伴",
      "en": "Partner"
    },
    "icon": "pet",
    "contributes": {
      "composer.strip": [
        {
          "id": "mood.strip",
          "icon": "heart",
          "panel": "mood"
        }
      ],
      "panels": [
        {
          "id": "mood",
          "title": "心情",
          "icon": "heart",
          "placement": ["chat.panel", "session.tab", "features"]
        },
        {
          "id": "memory",
          "title": "记忆",
          "icon": "note",
          "placement": ["session.tab", "features"]
        },
        {
          "id": "purpose",
          "title": "目的",
          "icon": "goal",
          "placement": ["session.tab", "features"]
        }
      ]
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {},
  "peerDependenciesMeta": {}
}
