index 0000000..47204e4
--- /dev/null
+++ b/app/android/app/src/test/kotlin/io/github/ccch1mneyyy/dsh_app/loop/core/KernelChainTest.kt
@@ -0,0 +1,128 @@
+package io.github.ccch1mneyyy.dsh_app.loop.core
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.random.Random
+
+/**
+ * The whole chain the round-2 task names, in pure logic:
+ * random schedule → local rules → queue → DSH arbitration → agent (plugin answers as recorded
+ * live) → interaction → answer or timeout → persisted receipt → next schedule.
+ * The adapter's job is exactly what this test's `drive` does.
+ */
+class KernelChainTest {
+    private var wall = 1_793_340_000_000L
+    private var elapsed = 3_600_000L
+    private val clocks get() = Clocks(wall, elapsed, 1)
+    private var seq = 0
+    private val coordStore = MemorySnapshotStore()
+    private val schedStore = MemorySnapshotStore()
+    private fun minuteOfDay(w: Long) = (((w + 8 * 3_600_000L) % 86_400_000L) / 60_000L).toInt()
+    private fun dayOf(w: Long) = Math.floorDiv(w + 8 * 3_600_000L, 86_400_000L)
+    private fun advance(ms: Long) { wall += ms; elapsed += ms }
+
+    private var coordinator = Coordinator(coordStore, CoordinatorConfig(), { wall }, { "c${++seq}" })
+    private var scheduler = ProactiveScheduler(schedStore, ::minuteOfDay, ::dayOf, Random(1), { "evt-${++seq}-0000" })
+    private var gate = Gate()
+
+    /** Agent requests the "engine" has open: requestId → answers it will give. */
+    private val agentCalls = mutableListOf<Command.RequestAgent>()
+    private val presented = mutableListOf<Command.Present>()
+
+    /** What the Android adapter does with a step. */
+    private fun drive(step: Step) {
+        for (c in step.commands) when (c) {
+            is Command.RequestAgent -> agentCalls += c
+            is Command.Present -> presented += c
+            else -> Unit
+        }
+        for (closed in step.closed) scheduler.onOutcome(closed.eventId, closed.engagement, clocks)
+    }
+
+    private fun scheduleTick() {
+        when (val d = scheduler.evaluate(clocks)) {
+            is ProactiveScheduler.Decision.Fire -> {
+                val (r, step) = coordinator.submit(d.request)
+                if (r is Submit.Rejected) scheduler.onRejected(r.reason, clocks) else scheduler.onSubmitted(d.request.eventId, clocks)
+                drive(step)
+            }
+            is ProactiveScheduler.Decision.Wait -> if (d.untilWall > wall) advance(d.untilWall - wall)
+        }
+    }
+
+    /** Plugin answers as recorded against DSH 0.2.1-rc.4 by e2e-live.mjs. */
+    private fun plugin(status: Int, body: Map<String, Any?>) {
+        val rq = agentCalls.last()
+        val d = AgentWire.decode(status, body) as AgentWire.Decoded.Reply
+        drive(coordinator.onAgent(rq.requestId, d.reply))
+    }
+
+    private fun boot() {
+        drive(coordinator.recover(gate))
+        scheduler.recover(clocks)
+        scheduler.setConfig(SchedulerConfig(enabled = true, minIntervalMs = 30 * 60_000L, maxIntervalMs = 60 * 60_000L,
+            quietStartMinute = 0, quietEndMinute = 0, dailyMax = 10), clocks)
+    }
+
+    @Test fun aScheduledChatGoesThroughTheAgentToTheScreenAndShapesTheNextGap() {
+        boot()
+        scheduleTick(); scheduleTick()
+        val rq = agentCalls.single()
+        assertNull("nothing on screen before the model answers", presented.firstOrNull())
+        plugin(202, mapOf("v" to 1L, "state" to "accepted"))
+        plugin(200, mapOf("v" to 1L, "state" to "claimed", "turn" to 1L))
+        plugin(200, mapOf("v" to 1L, "state" to "generated", "text" to "MOCK_REPLY: 你好", "turn" to 1L))
+        val p = presented.single()
+        assertEquals("MOCK_REPLY: 你好", p.content.text)
+        assertEquals(ContentSource.AGENT, p.content.source)
+        drive(coordinator.onSurface(p.token, SurfaceReport.Posted))
+        drive(coordinator.onSurface(p.token, SurfaceReport.Shown))
+        drive(coordinator.onSurface(p.token, SurfaceReport.Answered("reply")))
+        val r = coordinator.find(rq.eventId)!!
+        assertEquals(Outcome.RESPONDED, r.outcome)
+        listOf(r.agentRequestedAt, r.agentAcceptedAt, r.agentClaimedAt, r.generatedAt, r.presentedAt, r.deliveredAt, r.shownAt, r.respondedAt)
+            .forEach { assertNotNull("every fact recorded separately", it) }
+        assertNull(scheduler.state.pendingEventId)
+        assertEquals(1, scheduler.state.countToday)
+        assertTrue(scheduler.state.nextDueWall > wall)
+    }
+
+    @Test fun aScheduledChatWaitsForDshThenFallsBackWhenTheAgentIsBusy() {
+        boot()
+        gate = Gate(dshTaskActive = true)
+        drive(coordinator.setGate(gate))
+        scheduleTick(); scheduleTick()
+        assertTrue("no model call while DSH operates the phone", agentCalls.isEmpty())
+        gate = Gate()
+        drive(coordinator.setGate(gate))
+        plugin(409, mapOf("v" to 1L, "error" to mapOf("code" to "agent-busy")))
+        // Scheduler attempts have no canned text: a busy agent means no message, not a fake one.
+        val r = coordinator.receipts().first()
+        assertEquals(Outcome.FAILED to "agent_agent-busy", r.outcome to r.reason)
+        assertEquals(Engagement.NOT_DELIVERED, r.engagement)
+        assertTrue(presented.isEmpty())
+        assertEquals(0, scheduler.state.countToday)
+        assertTrue("retry soon, not at the full gap", scheduler.state.nextDueWall - wall <= 15 * 60_000L)
+    }
+
+    @Test fun processDeathMidTurnResumesThePollAndKeepsOneSchedule() {
+        boot()
+        scheduleTick(); scheduleTick()
+        val rq = agentCalls.single()
+        plugin(202, mapOf("v" to 1L, "state" to "accepted"))
+        // Process dies; a new one rebuilds both from disk.
+        coordinator = Coordinator(coordStore, CoordinatorConfig(), { wall }, { "c${++seq}" })
+        scheduler = ProactiveScheduler(schedStore, ::minuteOfDay, ::dayOf, Random(2), { "evt-${++seq}-0000" })
+        advance(5_000)
+        val rec = coordinator.recover(gate)
+        scheduler.recover(clocks)
+        assertEquals(rq.requestId, rec.commands.filterIsInstance<Command.ResumeAgent>().single().requestId)
+        assertEquals(rq.eventId, scheduler.state.pendingEventId)
+        assertTrue(scheduler.evaluate(clocks) is ProactiveScheduler.Decision.Wait)
+        drive(coordinator.onAgent(rq.requestId, AgentReply.Generated("after restart", "turn:1")))
+        assertEquals("after restart", presented.single().content.text)
+    }
+}
diff --git a/app/android/app/src/test/kotlin/io/github/ccch1mneyyy/dsh_app/loop/core/KernelRiskTest.kt b/app/android/app/src/test/kotlin/io/github/ccch1mneyyy/dsh_app/loop/core/KernelRiskTest.kt
new file mode 100644
index 0000000..a7a4339
--- /dev/null
+++ b/app/android/app/src/test/kotlin/io/github/ccch1mneyyy/dsh_app/loop/core/KernelRiskTest.kt
@@ -0,0 +1,176 @@
+package io.github.ccch1mneyyy.dsh_app.loop.core
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+import java.nio.file.Files
+
+/**
+ * The three cross-agent risks the round-2 hand-off named, at the layer where they can be proven
+ * without a device:
+ *
+ * 1. an agent request that is merely *waiting for its port* must not be judged a failure;
+ * 2. both state stores must survive a damaged file and never drop the last good state;
+ * 3. "the page was created / resumed" must not be recorded as "the person saw it".
+ *
+ * (3)'s platform half lives in ProactivePageActivity, which cannot run on the JVM; what the kernel
+ * promises is asserted here: only Shown counts as seen, Posted does not, and a notification can
+ * never claim it.
+ */
+class KernelRiskTest {
+    private var now = 1_793_340_000_000L
+    private var seq = 0
+
+    private val idleGate = Gate(featureEnabled = true, screenOn = true, unlocked = true, notificationsAllowed = true)
+
+    private fun request(kind: String = "app_enter", dedupe: String = "k", needsAgent: Boolean = true, fallback: String? = null) =
+        EventRequest(
+            eventId = "evt-${++seq}",
+            source = "SCHEDULER",
+            kind = kind,
+            dedupeKey = dedupe,
+            createdAt = now,
+            needsAgent = needsAgent,
+            fallbackText = fallback,
+        )
+
+    // ---- 1. waiting for the port is not a failure ---------------------------------------------
+
+    @Test fun anAgentRequestInsideItsDeadlineIsResumedAfterRestart() {
+        // A restart inside the turn's deadline must produce ResumeAgent — the adapter replays it once
+        // Dart connects — and never a failure just because no port existed at that instant.
+        val store = MemorySnapshotStore()
+        val coordinator = Coordinator(store, CoordinatorConfig(), { now }, { "r1" })
+        coordinator.recover(idleGate)
+        val (_, step) = coordinator.submit(request())
+        val req = step.commands.filterIsInstance<Command.RequestAgent>().single()
+        coordinator.onAgent(req.requestId, AgentReply.Accepted)
+
+        now += 10_000
+        val after = Coordinator(store, CoordinatorConfig(), { now }, { "r2" })
+        val recovered = after.recover(idleGate)
+        val resume = recovered.commands.filterIsInstance<Command.ResumeAgent>().singleOrNull()
+        assertNotNull("a live turn must be resumed, not failed", resume)
+        assertEquals(req.requestId, resume!!.requestId)
+        // The same request id: the plugin answers a replay from its record and never sends twice.
+        assertEquals(req.requestId, after.active()?.agentRequestId)
+        assertEquals(Stage.AWAITING_AGENT, after.active()?.stage)
+    }
+
+    @Test fun aRestartPastTheDeadlineFailsTheTurnInsteadOfHangingForever() {
+        val store = MemorySnapshotStore()
+        val coordinator = Coordinator(store, CoordinatorConfig(), { now }, { "r1" })
+        coordinator.recover(idleGate)
+        val (_, step) = coordinator.submit(request(fallback = "hi"))
+        val req = step.commands.filterIsInstance<Command.RequestAgent>().single()
+        coordinator.onAgent(req.requestId, AgentReply.Accepted)
+
+        now += 120_000 // well past the agent deadline
+        val after = Coordinator(store, CoordinatorConfig(), { now }, { "r2" })
+        val recovered = after.recover(idleGate)
+        assertTrue("no resume past the deadline", recovered.commands.filterIsInstance<Command.ResumeAgent>().isEmpty())
+        // With a fallback it moves on to a local message; without one it fails. Either way it is not stuck.
+        assertTrue(after.active()?.stage != Stage.AWAITING_AGENT)
+    }
+
+    // ---- 2. both stores survive a damaged file ------------------------------------------------
+
+    @Test fun theKernelStoreFallsBackToItsBackupAndSaysSo() {
+        val dir = Files.createTempDirectory("kernel").toFile()
+        val file = File(dir, "coordinator.json")
+        val store = AtomicJsonFile(file)
+        store.write(mapOf("version" to 1, "step" to 1))
+        store.write(mapOf("version" to 1, "step" to 2))
+        assertTrue("backup exists", File(dir, "coordinator.json.bak").exists())
+
+        // Power cut mid-write.
+        file.writeText("{\"version\": 1, \"step\"")
+        val read = store.read()
+        assertTrue("damaged file falls back", read is SnapshotStore.Read.Loaded)
+        val loaded = read as SnapshotStore.Read.Loaded
+        assertEquals("coordinator.json.bak", loaded.recoveredFrom)
+        // The backup holds the generation before the damaged one, by construction.
+        assertEquals(1L, (loaded.map["step"] as Number).toLong())
+        assertTrue("damaged file quarantined", File(dir, "coordinator.json.bad").exists())
+        dir.deleteRecursively()
+    }
+
+    @Test fun theKernelStoreNeverLeavesTheFileMissing() {
+        val dir = Files.createTempDirectory("kernel").toFile()
+        val file = File(dir, "scheduler.json")
+        val store = AtomicJsonFile(file)
+        repeat(5) { store.write(mapOf("version" to 1, "n" to it)) }
+        assertTrue("state exists", file.exists())
+        assertTrue("backup exists", File(dir, "scheduler.json.bak").exists())
+        assertTrue("temp cleaned up", !File(dir, "scheduler.json.tmp").exists())
+        val loaded = store.read() as SnapshotStore.Read.Loaded
+        assertNull("a healthy file is not a recovery", loaded.recoveredFrom)
+        assertEquals(4L, (loaded.map["n"] as Number).toLong())
+        dir.deleteRecursively()
+    }
+
+    @Test fun anEmptyKernelFileIsUnreadableNotEmpty() {
+        val dir = Files.createTempDirectory("kernel").toFile()
+        val file = File(dir, "coordinator.json").apply { writeText("") }
+        assertTrue(AtomicJsonFile(file).read() is SnapshotStore.Read.Unreadable)
+        dir.deleteRecursively()
+    }
+
+    // ---- 3. only a real Shown counts as seen --------------------------------------------------
+
+    @Test fun postedIsNotShownAndADismissedNeverShownIsNotIgnoredSeen() {
+        val coordinator = Coordinator(MemorySnapshotStore(), CoordinatorConfig(), { now }, { "e1" })
+        coordinator.recover(idleGate)
+        val (_, step) = coordinator.submit(request(needsAgent = false, fallback = "hi"))
+        val present = step.commands.filterIsInstance<Command.Present>().single()
+
+        // Handed to the system: delivered, but nobody has seen it.
+        coordinator.onSurface(present.token, SurfaceReport.Posted)
+        assertNull("delivery is not visibility", coordinator.active()?.shownAt)
+        if (present.surface == Surface.NOTIFICATION) {
+            assertEquals(Stage.DELIVERED, coordinator.active()?.stage)
+        } else {
+            // An activity that was posted but never confirmed on screen stays PRESENTING: this is
+            // exactly the state the 3-second watchdog uses to fall back to a notification.
+            assertEquals(Stage.PRESENTING, coordinator.active()?.stage)
+        }
+
+        // Swiped away without ever being shown: not "seen", so the ignored backoff must not count it.
+        val closed = coordinator.onSurface(present.token, SurfaceReport.Dismissed).closed.single()
+        assertTrue("a never-shown event is not IGNORED_SEEN", closed.engagement != Engagement.IGNORED_SEEN)
+    }
+
+    @Test fun aShownReportRecordsTheTimestamp() {
+        val coordinator = Coordinator(MemorySnapshotStore(), CoordinatorConfig(), { now }, { "e1" })
+        coordinator.recover(idleGate)
+        val (_, step) = coordinator.submit(request(needsAgent = false, fallback = "hi"))
+        val present = step.commands.filterIsInstance<Command.Present>().single()
+        coordinator.onSurface(present.token, SurfaceReport.Posted)
+        now += 1_000
+        coordinator.onSurface(present.token, SurfaceReport.Shown)
+        assertEquals(now, coordinator.active()?.shownAt)
+        assertEquals(Stage.SHOWN, coordinator.active()?.stage)
+    }
+
+    @Test fun aStaleTokenCannotReportShownForANewerEvent() {
+        // Every id the coordinator mints (event ids, request ids, presentation tokens) must be
+        // distinct, otherwise a stale page could match a newer token. Give it a real sequence.
+        var ids = 0
+        val coordinator = Coordinator(MemorySnapshotStore(), CoordinatorConfig(), { now }, { "id-${++ids}" })
+        coordinator.recover(idleGate)
+        val (_, step) = coordinator.submit(request(needsAgent = false, fallback = "hi"))
+        val old = step.commands.filterIsInstance<Command.Present>().single().token
+        coordinator.cancel(coordinator.active()!!.eventId, "test")
+
+        val (_, step2) = coordinator.submit(request(dedupe = "k2", needsAgent = false, fallback = "hi2"))
+        val fresh = step2.commands.filterIsInstance<Command.Present>().single()
+        assertTrue("a new presentation gets a new token", old != fresh.token)
+
+        // The stale page reporting Shown must not touch the new event.
+        coordinator.onSurface(old, SurfaceReport.Shown)
+        assertNull("a stale page cannot claim the new event was shown", coordinator.active()?.shownAt)
+    }
+}
diff --git a/app/android/app/src/test/kotlin/io/github/ccch1mneyyy/dsh_app/loop/core/ProactiveSchedulerTest.kt b/app/android/app/src/test/kotlin/io/github/ccch1mneyyy/dsh_app/loop/core/ProactiveSchedulerTest.kt
new file mode 100644
index 0000000..c42dc64
--- /dev/null
+++ b/app/android/app/src/test/kotlin/io/github/ccch1mneyyy/dsh_app/loop/core/ProactiveSchedulerTest.kt
@@ -0,0 +1,243 @@
+package io.github.ccch1mneyyy.dsh_app.loop.core
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import kotlin.random.Random
+
+/** T6. The local zone is UTC+8 here; the scheduler only sees it through minuteOfDay / dayOf. */
+class ProactiveSchedulerTest {
+    private val zone = 8 * 3_600_000L
+    private val min = 60_000L
+    private val hour = 60 * min
+    /** 2026-10-30 10:00 local. */
+    private var wall = 1_793_325_600_000L - zone + 10 * hour - (1_793_325_600_000L % 86_400_000L)
+    private var elapsed = 5 * hour
+    private var boot = 1
+    private val store = MemorySnapshotStore()
+    private var seq = 0
+    private fun now() = Clocks(wall, elapsed, boot)
+    private fun advance(ms: Long) { wall += ms; elapsed += ms }
+    private fun minuteOfDay(w: Long) = (((w + zone) % 86_400_000L) / min).toInt()
+    private fun dayOf(w: Long) = Math.floorDiv(w + zone, 86_400_000L)
+
+    private val cfg = SchedulerConfig(
+        enabled = true, minIntervalMs = 30 * min, maxIntervalMs = 90 * min, quietStartMinute = 23 * 60, quietEndMinute = 8 * 60,
+        dailyMax = 4, userActiveDeferMs = 20 * min, ignoredBackoff = 2.0, maxBackoffFactor = 8.0, pauseAfterIgnored = 3,
+    )
+
+    private fun scheduler(seed: Int = 7, s: SnapshotStore = store) =
+        ProactiveScheduler(s, ::minuteOfDay, ::dayOf, Random(seed), { "sched-${++seq}" })
+
+    private fun armed(seed: Int = 7): ProactiveScheduler = scheduler(seed).also { it.recover(now()); it.setConfig(cfg, now()) }
+
+    /** Advance to the due time and return the attempt. */
+    private fun ProactiveScheduler.fireNext(): EventRequest {
+        val w = evaluate(now())
+        if (w is ProactiveScheduler.Decision.Wait) advance(w.untilWall - wall)
+        val d = evaluate(now())
+        assertTrue("expected Fire, got $d", d is ProactiveScheduler.Decision.Fire)
+        return (d as ProactiveScheduler.Decision.Fire).request.also { onSubmitted(it.eventId, now()) }
+    }
+
+    private fun gap(s: ProactiveScheduler) = s.state.nextDueElapsed - elapsed
+
+    @Test fun firstGapIsRandomWithinTheConfiguredRangeAndTheDecisionIsDeterministic() {
+        val gaps = (1..20).map { seed -> scheduler(seed, MemorySnapshotStore()).also { it.recover(now()); it.setConfig(cfg, now()) }.let { gap(it) } }
+        assertTrue(gaps.all { it in 30 * min..90 * min })
+        assertTrue("random, not constant", gaps.toSet().size > 10)
+        val s = armed()
+        val a = s.evaluate(now())
+        assertEquals(a, s.evaluate(now()))
+        assertEquals("not_due", (a as ProactiveScheduler.Decision.Wait).reason)
+    }
+
+    @Test fun anAttemptIsAProactiveEventForTheCoordinator() {
+        val r = armed().fireNext()
+        assertEquals("SCHEDULER", r.source)
+        assertEquals("scheduler:random", r.dedupeKey)
+        assertTrue(r.needsAgent)
+        assertNull("no canned text: without the agent it fails rather than fakes", r.fallbackText)
+    }
+
+    @Test fun pendingAttemptBlocksAnotherAndOnlyItsReceiptCounts() {
+        val s = armed()
+        val r = s.fireNext()
+        advance(10 * hour)
+        assertEquals("pending", (s.evaluate(now()) as ProactiveScheduler.Decision.Wait).reason)
+        assertFalse("someone else's receipt", s.onOutcome("other", Engagement.RESPONDED, now()))
+        assertTrue(s.onOutcome(r.eventId, Engagement.RESPONDED, now()))
+        assertFalse("duplicate receipt", s.onOutcome(r.eventId, Engagement.RESPONDED, now()))
+        assertEquals(1, s.state.countToday)
+    }
+
+    @Test fun quietHoursPushAttemptsToTheMorning() {
+        val s = armed()
+        advance(13 * hour) // 23:00
+        assertEquals("quiet", (s.evaluate(now()) as ProactiveScheduler.Decision.Wait).reason)
+        val until = (s.evaluate(now()) as ProactiveScheduler.Decision.Wait).untilWall
+        assertEquals(8 * 60, minuteOfDay(until))
+        // A plan that would land at night is moved past the quiet end.
+        val r = s.fireNext()
+        assertTrue(minuteOfDay(wall) >= 8 * 60)
+        s.onOutcome(r.eventId, Engagement.RESPONDED, now())
+    }
+
+    @Test fun dailyMaxCountsDeliveriesNotAttempts() {
+        val s = armed()
+        repeat(2) { s.onOutcome(s.fireNext().eventId, Engagement.NOT_DELIVERED, now()) }
+        assertEquals("undelivered attempts do not count", 0, s.state.countToday)
+        var guard = 0
+        while (s.state.countToday < 4 && guard++ < 20) {
+            val w = s.evaluate(now())
+            if (w is ProactiveScheduler.Decision.Wait && w.reason == "quiet") { advance(w.untilWall - wall); continue }
+            s.onOutcome(s.fireNext().eventId, Engagement.UNCONFIRMED, now())
+        }
+        val d = s.evaluate(now())
+        if (minuteOfDay(wall) < 23 * 60 && dayOf(wall) == s.state.dayKey) {
+            assertEquals("daily_max", (d as ProactiveScheduler.Decision.Wait).reason)
+            assertEquals(8 * 60, minuteOfDay(d.untilWall))
+        }
+    }
+
+    @Test fun userActivityResetsTheStreakAndKeepsOutOfTheWay() {
+        val s = armed()
+        val r = s.fireNext()
+        s.onOutcome(r.eventId, Engagement.IGNORED_SEEN, now())
+        assertEquals(1, s.state.ignoredStreak)
+        advance(5 * hour)
+        s.onUserActivity(now())
+        assertEquals(0, s.state.ignoredStreak)
+        assertTrue(gap(s) >= 20 * min)
+        assertEquals("not_due", (s.evaluate(now()) as ProactiveScheduler.Decision.Wait).reason)
+        advance(gap(s))
+        assertTrue(s.evaluate(now()) is ProactiveScheduler.Decision.Fire)
+    }
+
+    // 9. Two confirmed deliveries in a row with no answer
+    @Test fun ignoredMessagesWidenTheGapAndThenPause() {
+        val s = armed(seed = 3)
+        s.onOutcome(s.fireNext().eventId, Engagement.IGNORED_SEEN, now())
+        s.onOutcome(s.fireNext().eventId, Engagement.IGNORED_SEEN, now())
+        assertEquals(2, s.state.ignoredStreak)
+        assertTrue("×4 after two ignored: ${gap(s) / min} min", gap(s) >= 4 * 30 * min)
+        assertTrue(gap(s) <= 4 * 90 * min + 8 * hour + 30 * min)
+        s.onOutcome(s.fireNext().eventId, Engagement.IGNORED_SEEN, now())
+        assertTrue(s.state.pausedForIgnored)
+        advance(3 * 86_400_000L)
+        assertEquals("paused_ignored", (s.evaluate(now()) as ProactiveScheduler.Decision.Wait).reason)
+        s.onUserActivity(now())
+        assertFalse(s.state.pausedForIgnored)
+    }
+
+    // 8. A notification posted but never confirmed seen
+    @Test fun unconfirmedDeliveryIsNeitherPenalisedNorRewarded() {
+        val s = armed()
+        s.onOutcome(s.fireNext().eventId, Engagement.IGNORED_SEEN, now())
+        s.onOutcome(s.fireNext().eventId, Engagement.UNCONFIRMED, now())
+        assertEquals(1, s.state.ignoredStreak)
+        assertEquals(2, s.state.countToday)
+    }
+
+    @Test fun undeliveredAttemptsRetrySoonButNotForever() {
+        val s = armed()
+        s.onOutcome(s.fireNext().eventId, Engagement.NOT_DELIVERED, now())
+        assertTrue(gap(s) in 10 * min..15 * min)
+        s.onOutcome(s.fireNext().eventId, Engagement.NOT_DELIVERED, now())
+        s.onOutcome(s.fireNext().eventId, Engagement.NOT_DELIVERED, now())
+        assertTrue("back to the normal gap after repeated failures", gap(s) >= 30 * min)
+    }
+
+    // 7. Clock changes
+    @Test fun movingTheWallClockNeitherRushesNorDelaysAnAttemptWithinOneBoot() {
+        val s = armed()
+        val g = gap(s)
+        wall += 6 * hour // set forward
+        assertEquals("not_due", (s.evaluate(now()) as ProactiveScheduler.Decision.Wait).reason)
+        wall -= 12 * hour // set back
+        elapsed += g
+        val d = s.evaluate(now())
+        assertTrue("due by elapsed time, quiet hours by the new wall time: $d",
+            d is ProactiveScheduler.Decision.Fire || (d as ProactiveScheduler.Decision.Wait).reason == "quiet")
+    }
+
+    @Test fun settingTheDateBackDoesNotResetTheDailyCount() {
+        val s = armed()
+        repeat(2) { s.onOutcome(s.fireNext().eventId, Engagement.UNCONFIRMED, now()) }
+        wall -= 2 * 86_400_000L
+        s.evaluate(now())
+        assertEquals(2, s.state.countToday)
+    }
+
+    // 6. Process restart and reboot
+    @Test fun restartKeepsThePlanAndRebootFallsBackToTheWallClock() {
+        val s = armed()
+        val due = s.state.nextDueWall
+        val restarted = scheduler()
+        restarted.recover(now())
+        assertEquals(due, restarted.state.nextDueWall)
+        assertEquals(s.state, restarted.state)
+        // Reboot: elapsed restarts near zero; the wall time still holds.
+        boot = 2; elapsed = 60_000
+        val afterBoot = scheduler()
+        afterBoot.recover(now())
+        assertEquals(due, afterBoot.state.nextDueWall)
+        advance(due - wall)
+        assertTrue(afterBoot.evaluate(now()) is ProactiveScheduler.Decision.Fire || minuteOfDay(wall) < 8 * 60 || minuteOfDay(wall) >= 23 * 60)
+    }
+
+    @Test fun rebootWithAJumpedClockOrALongOffPeriodReplans() {
+        val s = armed()
+        val due = s.state.nextDueWall
+        boot = 2; elapsed = 60_000; wall -= 30 * 86_400_000L
+        val jumped = scheduler(); jumped.recover(now())
+        assertEquals("clock_jump", jumped.state.lastReason)
+        assertTrue(jumped.state.nextDueWall < due)
+        wall += 60 * 86_400_000L; boot = 3
+        val off = scheduler(); off.recover(now())
+        assertEquals("missed_while_off", off.state.lastReason)
+        assertTrue(off.state.nextDueWall > wall)
+    }
+
+    @Test fun aLostPendingAttemptIsReleasedOnRecovery() {
+        val s = armed()
+        s.fireNext()
+        advance(2 * hour)
+        val r = scheduler(); r.recover(now())
+        assertNull(r.state.pendingEventId)
+        assertEquals("pending_lost", r.state.lastReason)
+    }
+
+    // 11. Switched off
+    @Test fun disabledSchedulerNeverFiresAndForgetsItsPendingAttempt() {
+        val s = armed()
+        s.fireNext()
+        s.setConfig(cfg.copy(enabled = false), now())
+        assertNull(s.state.pendingEventId)
+        advance(10 * hour)
+        assertEquals("disabled", (s.evaluate(now()) as ProactiveScheduler.Decision.Wait).reason)
+        assertNull(s.nextWake(now(), WakeMode.EXACT))
+    }
+
+    @Test fun wakeModesDegradeSafely() {
+        assertEquals(WakeMode.EXACT, WakeMode.of(BackgroundCaps()))
+        assertEquals(WakeMode.INEXACT, WakeMode.of(BackgroundCaps(exactAlarms = false)))
+        assertEquals(WakeMode.OPPORTUNISTIC, WakeMode.of(BackgroundCaps(backgroundRestricted = true)))
+        assertEquals(WakeMode.OPPORTUNISTIC, WakeMode.of(BackgroundCaps(alarmsAvailable = false)))
+        val s = armed()
+        assertNull("no alarm when the system forbids background work", s.nextWake(now(), WakeMode.OPPORTUNISTIC))
+        assertEquals(s.state.nextDueWall, s.nextWake(now(), WakeMode.INEXACT))
+    }
+
+    @Test fun configIsNormalizedAndPersisted() {
+        val n = SchedulerConfig(enabled = true, minIntervalMs = 1, maxIntervalMs = 0, dailyMax = -3, quietStartMinute = 5000).normalized()
+        assertEquals(60_000L, n.minIntervalMs)
+        assertEquals(60_000L, n.maxIntervalMs)
+        assertEquals(0, n.dailyMax)
+        assertEquals(1439, n.quietStartMinute)
+        armed()
+        assertEquals(cfg, scheduler().also { it.recover(now()) }.config)
+    }
+}
diff --git a/app/lib/app.dart b/app/lib/app.dart
index 2ca9aed..e8a6d28 100644
--- a/app/lib/app.dart
