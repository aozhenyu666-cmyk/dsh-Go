+    }
+
+    // 6. Process death
+    @Test fun restartResumesTheAgentRequestKeepsTheQueueAndAbandonsPagesOnScreen() {
+        val c = coordinator().also { it.recover(Gate()) }
+        val rq = c.submit(req("a", agent = true)).second.only<Command.RequestAgent>().single()
+        c.submit(req("b"))
