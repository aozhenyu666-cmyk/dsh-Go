diff --git a/app/lib/loop/loop_channel.dart b/app/lib/loop/loop_channel.dart
new file mode 100644
index 0000000..b3c7ea3
--- /dev/null
+++ b/app/lib/loop/loop_channel.dart
@@ -0,0 +1,353 @@
+// Dart side of the `dsh/loop` method channel (android/.../loop/LoopPlugin.kt):
+// 设置 → 手机操控 → 触发测试, the first closed loop.
+
+import 'package:flutter/services.dart';
+
+class LoopConfig {
+  const LoopConfig({
+    this.enabled = false,
+    this.targetPackage,
+    this.cooldownMs = 60000,
+    this.timeoutMs = 60000,
+    this.quietStartMinute,
+    this.quietEndMinute,
+    this.dailyCap = 0,
+  });
+
+  final bool enabled;
+  final String? targetPackage;
+  final int cooldownMs;
+  final int timeoutMs;
+
+  /// Quiet hours, minutes after midnight. [quietEndMinute] smaller than [quietStartMinute] crosses midnight.
+  final int? quietStartMinute;
+  final int? quietEndMinute;
+
+  /// Maximum triggers per day; 0 = unlimited.
+  final int dailyCap;
+
+  bool get quietHoursSet => quietStartMinute != null && quietEndMinute != null && quietStartMinute != quietEndMinute;
+
+  /// The same shape the native side sends, so an export round-trips.
+  Map<String, Object?> toMap() => {
+    'enabled': enabled,
+    'targetPackage': targetPackage,
+    'cooldownMs': cooldownMs,
+    'timeoutMs': timeoutMs,
+    'quietStartMinute': quietStartMinute,
+    'quietEndMinute': quietEndMinute,
+    'dailyCap': dailyCap,
+  };
+
+  static LoopConfig fromWire(Object? raw) {
+    final m = raw is Map ? raw : const {};
+    int? n(Object? v) => v is num ? v.toInt() : null;
+    return LoopConfig(
+      enabled: m['enabled'] == true,
+      targetPackage: m['targetPackage'] is String ? m['targetPackage'] as String : null,
+      cooldownMs: m['cooldownMs'] is num ? (m['cooldownMs'] as num).toInt() : 60000,
+      timeoutMs: m['timeoutMs'] is num ? (m['timeoutMs'] as num).toInt() : 60000,
+      quietStartMinute: n(m['quietStartMinute']),
+      quietEndMinute: n(m['quietEndMinute']),
+      dailyCap: n(m['dailyCap']) ?? 0,
+    );
+  }
+}
+
+/// One fault the native side kept: an accessibility handler, a foreground read, a surface.
+class LoopFault {
+  const LoopFault({required this.kind, required this.detail, required this.at});
+
+  final String kind;
+  final String detail;
+  final DateTime at;
+
+  Map<String, Object?> toMap() => {'kind': kind, 'detail': detail, 'at': at.millisecondsSinceEpoch};
+
+  static LoopFault? fromWire(Object? raw) {
+    if (raw is! Map) return null;
+    final kind = raw['kind'];
+    final at = raw['at'];
+    if (kind is! String || at is! num) return null;
+    return LoopFault(
+      kind: kind,
+      detail: raw['detail'] is String ? raw['detail'] as String : '',
+      at: DateTime.fromMillisecondsSinceEpoch(at.toInt()),
+    );
+  }
+}
+
+/// `status.diagnostics`: what the settings page needs to explain a silent loop.
+class LoopDiagnosticsView {
+  const LoopDiagnosticsView({
+    this.faults = const {},
+    this.streaks = const {},
+    this.recent = const [],
+    this.lastEventAt,
+    this.lastVerifyAt,
+    this.lastReadAt,
+  });
+
+  /// Total failures per kind since process start.
+  final Map<String, int> faults;
+
+  /// Failures in a row right now per kind.
+  final Map<String, int> streaks;
+  final List<LoopFault> recent;
+  final DateTime? lastEventAt;
+  final DateTime? lastVerifyAt;
+  final DateTime? lastReadAt;
+
+  bool get isEmpty => faults.isEmpty && lastEventAt == null && lastVerifyAt == null && lastReadAt == null;
+
+  /// For the JSON export.
+  Map<String, Object?> toMap() => {
+    'faults': faults,
+    'streaks': streaks,
+    'recent': [for (final f in recent) f.toMap()],
+    'lastEventAt': lastEventAt?.millisecondsSinceEpoch,
+    'lastVerifyAt': lastVerifyAt?.millisecondsSinceEpoch,
+    'lastReadAt': lastReadAt?.millisecondsSinceEpoch,
+  };
+
+  static LoopDiagnosticsView fromWire(Object? raw) {
+    final m = raw is Map ? raw : const {};
+    Map<String, int> counts(Object? v) {
+      if (v is! Map) return const {};
+      return {
+        for (final e in v.entries)
+          if (e.key is String && e.value is num) e.key as String: (e.value as num).toInt(),
+      };
+    }
+
+    DateTime? ts(Object? v) => v is num ? DateTime.fromMillisecondsSinceEpoch(v.toInt()) : null;
+    return LoopDiagnosticsView(
+      faults: counts(m['faults']),
+      streaks: counts(m['streaks']),
+      recent: [for (final f in (m['recent'] is List ? m['recent'] as List : const [])) ?LoopFault.fromWire(f)],
+      lastEventAt: ts(m['lastEventAt']),
+      lastVerifyAt: ts(m['lastVerifyAt']),
+      lastReadAt: ts(m['lastReadAt']),
+    );
+  }
+}
+
+class LoopStatus {
+  const LoopStatus({
+    this.config = const LoopConfig(),
+    this.a11yEnabled = false,
+    this.a11yConnected = false,
+    this.eventsSeen = 0,
+    this.readings = 0,
+    this.lastForeground,
+    this.storageError,
+    this.recoveredFrom,
+    this.insideTarget = false,
+    this.triggersToday = 0,
+    this.triggerDay,
+    this.diagnostics = const LoopDiagnosticsView(),
+  });
+
+  final LoopConfig config;
+  final bool a11yEnabled;
+  final bool a11yConnected;
+  final int eventsSeen;
+  final int readings;
+  final String? lastForeground;
+  final String? storageError;
+
+  /// Non-null when the state file was damaged and the backup was loaded instead.
+  final String? recoveredFrom;
+  final bool insideTarget;
+
+  /// Triggers spent today, and which day that was.
+  final int triggersToday;
+  final String? triggerDay;
+
+  final LoopDiagnosticsView diagnostics;
+
+  static LoopStatus fromWire(Object? raw) {
+    final m = raw is Map ? raw : const {};
+    int n(Object? v) => v is num ? v.toInt() : 0;
+    String? s(Object? v) => v is String ? v : null;
+    return LoopStatus(
+      config: LoopConfig.fromWire(m['config']),
+      a11yEnabled: m['a11yEnabled'] == true,
+      a11yConnected: m['a11yConnected'] == true,
+      eventsSeen: n(m['eventsSeen']),
+      readings: n(m['readings']),
+      lastForeground: s(m['lastForeground']),
+      storageError: s(m['storageError']),
+      recoveredFrom: s(m['recoveredFrom']),
+      insideTarget: m['insideTarget'] == true,
+      triggersToday: n(m['triggersToday']),
+      triggerDay: s(m['triggerDay']),
+      diagnostics: LoopDiagnosticsView.fromWire(m['diagnostics']),
+    );
+  }
+}
+
+/// One receipt: the shared event record (eventId, source, timestamp, state, result, error).
+class LoopEvent {
+  const LoopEvent({
+    required this.eventId,
+    required this.source,
+    required this.timestamp,
+    required this.state,
+    this.result,
+    this.error,
+    this.reason,
+    this.packageName,
+    this.visitId,
+    this.surface,
+    this.updatedAt,
+  });
+
+  final String eventId;
+  final String source;
+  final DateTime timestamp;
+
+  /// CONFIRMED / TRIGGERED / SHOWN / CLOSED.
+  final String state;
+
+  /// RETURNED / BACK / DISMISSED / TIMEOUT / ABANDONED / UNAVAILABLE / SUPPRESSED / ERROR; null while open.
+  final String? result;
+  final String? error;
+  final String? reason;
+  final String? packageName;
+
+  /// One visit = one stay in the test app; at most one trigger per visit.
+  final String? visitId;
+
+  /// "activity" or "notification" (T3's fallback surface).
+  final String? surface;
+  final DateTime? updatedAt;
+
+  /// For the JSON export: the same fields the native receipt carries.
+  Map<String, Object?> toMap() => {
+    'eventId': eventId,
+    'source': source,
+    'timestamp': timestamp.millisecondsSinceEpoch,
+    'state': state,
+    'result': result,
+    'error': error,
+    'reason': reason,
+    'packageName': packageName,
+    'visitId': visitId,
+    'surface': surface,
+    'updatedAt': updatedAt?.millisecondsSinceEpoch,
+  };
+
+  static LoopEvent? fromWire(Object? raw) {
+    if (raw is! Map) return null;
+    final id = raw['eventId'];
+    final ts = raw['timestamp'];
+    if (id is! String || ts is! num) return null;
+    String? s(Object? v) => v is String ? v : null;
+    final up = raw['updatedAt'];
+    return LoopEvent(
+      eventId: id,
+      source: s(raw['source']) ?? '',
+      timestamp: DateTime.fromMillisecondsSinceEpoch(ts.toInt()),
+      state: s(raw['state']) ?? '',
+      result: s(raw['result']),
+      error: s(raw['error']),
+      reason: s(raw['reason']),
+      packageName: s(raw['packageName']),
+      visitId: s(raw['visitId']),
+      surface: s(raw['surface']),
+      updatedAt: up is num ? DateTime.fromMillisecondsSinceEpoch(up.toInt()) : null,
+    );
+  }
+}
+
+class LoopApp {
+  const LoopApp(this.package, this.label);
+
+  final String package;
+  final String label;
+}
+
+class LoopChannel {
+  LoopChannel({MethodChannel? methods}) : _methods = methods ?? const MethodChannel('dsh/loop');
+
+  final MethodChannel _methods;
+
+  /// Null when the native side is missing or failed.
+  Future<LoopStatus?> status() async {
+    try {
+      return LoopStatus.fromWire(await _methods.invokeMethod<Object?>('status'));
+    } on Exception {
+      return null;
+    }
+  }
+
+  /// Only the given fields change. [clearTarget] sets the test app to none,
+  /// [clearQuietHours] removes the quiet window.
+  Future<LoopConfig?> setConfig({
+    bool? enabled,
+    String? targetPackage,
+    bool clearTarget = false,
+    int? cooldownMs,
+    int? timeoutMs,
+    int? quietStartMinute,
+    int? quietEndMinute,
+    bool clearQuietHours = false,
+    int? dailyCap,
+  }) async {
+    try {
+      final raw = await _methods.invokeMethod<Object?>('setConfig', {
+        'enabled': ?enabled,
+        if (targetPackage != null || clearTarget) 'targetPackage': targetPackage,
+        'cooldownMs': ?cooldownMs,
+        'timeoutMs': ?timeoutMs,
+        if (clearQuietHours) ...{'quietStartMinute': null, 'quietEndMinute': null}
+        else if (quietStartMinute != null || quietEndMinute != null) ...{
+          'quietStartMinute': ?quietStartMinute,
+          'quietEndMinute': ?quietEndMinute,
+        },
+        'dailyCap': ?dailyCap,
+      });
+      return LoopConfig.fromWire(raw);
+    } on Exception {
+      return null;
+    }
+  }
+
+  Future<List<LoopEvent>> events({int limit = 50}) async {
+    try {
+      final raw = await _methods.invokeMethod<List<Object?>>('events', {'limit': limit});
+      return [for (final e in raw ?? const []) ?LoopEvent.fromWire(e)];
+    } on Exception {
+      return const [];
+    }
+  }
+
+  Future<bool> clearEvents() async {
+    try {
+      return await _methods.invokeMethod<bool>('clearEvents') ?? false;
+    } on Exception {
+      return false;
+    }
+  }
+
+  Future<bool> clearDiagnostics() async {
+    try {
+      return await _methods.invokeMethod<bool>('clearDiagnostics') ?? false;
+    } on Exception {
+      return false;
+    }
+  }
+
+  Future<List<LoopApp>> apps() async {
+    try {
+      final raw = await _methods.invokeMethod<List<Object?>>('apps');
+      return [
+        for (final a in raw ?? const [])
+          if (a is Map && a['package'] is String) LoopApp(a['package'] as String, (a['label'] as String?) ?? a['package'] as String),
+      ];
+    } on Exception {
+      return const [];
+    }
+  }
+}
diff --git a/app/lib/proactive/proactive_channel.dart b/app/lib/proactive/proactive_channel.dart
new file mode 100644
index 0000000..c64fe6f
--- /dev/null
+++ b/app/lib/proactive/proactive_channel.dart
@@ -0,0 +1,194 @@
+// D1: the Dart half of the proactive Agent transport.
+//
+// The kernel (loop/core) never touches the network itself: it asks Dart, which is the side that
+// holds the engine's authenticated cookie, to carry one HTTP call to the dsh-go-proactive host
+// plugin and hands the raw answer back. Three ops, and nothing else:
+//
+//   request (POST /dsh-go-proactive/v1/request)   poll (GET .../result?requestId=…&waitMs=…)
+//   cancel  (POST /dsh-go-proactive/v1/cancel)
+//
+// Rules this file keeps, because the kernel relies on them:
+//  * the answer is never interpreted — status and body go back verbatim, so one decoder decides;
+//  * a transport failure is `status: 0`, never an invented HTTP code;
+//  * nothing is forwarded on a remote host: the plugin only lives on this machine, so the honest
+//    answer there is 404 (and the kernel turns "no plugin" into its own failure state);
+//  * the plugin route is *not* under /api and is not authenticated by the engine; it needs the
+//    same cookie the rest of the app uses, which is exactly what the connection carries.
+
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:dsh_client/dsh_client.dart';
+import 'package:flutter/services.dart';
+
+/// One command from the kernel: `{op, requestId, path, body?}`.
+class ProactiveAgentOp {
+  const ProactiveAgentOp({required this.op, required this.requestId, required this.path, this.body});
+
+  final String op;
+  final String requestId;
+  final String path;
+  final Map<String, Object?>? body;
+
+  /// Null when the message is not one of the three ops — the kernel is the only sender, so a
+  /// malformed message means a version mismatch, and answering it as a failure is the safe move.
+  static ProactiveAgentOp? fromWire(Object? raw) {
+    if (raw is! Map) return null;
+    final op = raw['op'];
+    final requestId = raw['requestId'];
+    final path = raw['path'];
+    if (op is! String || requestId is! String || path is! String) return null;
+    if (op != 'request' && op != 'poll' && op != 'cancel') return null;
+    final body = raw['body'];
+    return ProactiveAgentOp(
+      op: op,
+      requestId: requestId,
+      path: path,
+      body: body is Map ? body.cast<String, Object?>() : null,
+    );
+  }
+
+  /// The transport the kernel described: simple and easy to assert in a test.
+  bool get isPost => op == 'request' || op == 'cancel';
+}
+
+/// What goes back to the kernel on `dsh/proactive` → `agentHttp`.
+class ProactiveAgentAnswer {
+  const ProactiveAgentAnswer(this.requestId, this.status, [this.body]);
+
+  final String requestId;
+
+  /// HTTP status, or 0 when the request never got an answer.
+  final int status;
+  final Object? body;
+
+  Map<String, Object?> toWire() => {'requestId': requestId, 'status': status, 'body': body};
+}
+
+/// What the transport needs from the app's connection: where it points, and the two HTTP verbs.
+///
+/// A narrow seam instead of the whole [DshConnection], because that class owns a real
+/// `HttpClient` and a cookie jar; a test that has to build one cannot say "this failed with a
+/// socket error" or "this is a remote host" without a server.
+abstract class ProactiveForwardTarget {
+  /// The plugin ships with the runtime on this machine; a remote host has no such route.
+  bool get isLocal;
+
+  Future<(int status, String body)> postJson(String path, Map<String, Object?> body);
+  Future<(int status, String body)> get(String path);
+}
+
+/// The real target: the authenticated connection of the current host.
+class DshConnectionTarget implements ProactiveForwardTarget {
+  const DshConnectionTarget(this.connection, {required this.isLocal});
+
+  /// `HostConnection.client.connection` — the same cookie the rest of the app uses.
+  final DshConnection connection;
+
+  @override
+  final bool isLocal;
+
+  @override
+  Future<(int, String)> postJson(String path, Map<String, Object?> body) async {
+    final response = await connection.postJson(path, body);
+    return (response.statusCode, response.text);
+  }
+
+  @override
+  Future<(int, String)> get(String path) async {
+    final response = await connection.get(path);
+    return (response.statusCode, response.text);
+  }}
+
+/// Carries the kernel's agent commands to the host plugin. Created once, at app start.
+class ProactiveAgentTransport {
+  ProactiveAgentTransport({MethodChannel? methods, EventChannel? events, this.targetOf})
+    : _methods = methods ?? const MethodChannel('dsh/proactive'),
+      _events = events ?? const EventChannel('dsh/proactive/agent');
+
+  final MethodChannel _methods;
+  final EventChannel _events;
+
+  /// The target to forward on; null when not connected. Tests pass their own.
+  final ProactiveForwardTarget? Function()? targetOf;
+
+  StreamSubscription<Object?>? _sub;
+
+  /// Route prefix of the plugin (docs/AGENT_PROTOCOL.md).
+  static const routePrefix = '/dsh-go-proactive/v1';
+
+  void start() {
+    if (_sub != null) return;
+    _sub = _events.receiveBroadcastStream().listen(
+      (raw) => unawaited(_onOp(ProactiveAgentOp.fromWire(raw))),
+      onError: (Object e) {
+        // A broken channel must not take the app down; the kernel sees its request time out.
+        _debug('proactive agent channel error: $e');
+      },
+    );
+  }
+
+  Future<void> stop() async {
+    await _sub?.cancel();
+    _sub = null;
+  }
+
+  Future<void> _onOp(ProactiveAgentOp? op) async {
+    if (op == null) return;
+    final answer = await forward(op);
+    try {
+      await _methods.invokeMethod<void>('agentHttp', answer.toWire());
+    } on PlatformException catch (e) {
+      _debug('agentHttp failed for ${op.requestId}: ${e.code}');
+    }
+  }
+
+  /// Runs one op and reports what happened, without interpreting the answer.
+  Future<ProactiveAgentAnswer> forward(ProactiveAgentOp op) async {
+    final target = targetOf?.call();
+    if (target == null) return ProactiveAgentAnswer(op.requestId, 0);
+    if (!target.isLocal) return ProactiveAgentAnswer(op.requestId, 404);
+    final path = op.path.startsWith('/') ? op.path : '/${op.path}';
+    try {
+      final (status, body) = op.isPost ? await target.postJson(path, op.body ?? const {}) : await target.get(path);
+      return ProactiveAgentAnswer(op.requestId, status, _decode(body));
+    } catch (e) {
+      // No answer at all (socket, timeout, TLS): 0, never a made-up status.
+      _debug('proactive ${op.op} ${op.path} failed: $e');
+      return ProactiveAgentAnswer(op.requestId, 0);
+    }
+  }
+
+  Object? _decode(String body) {
+    if (body.isEmpty) return null;
+    try {
+      return jsonDecode(body);
+    } on FormatException {
+      // Not JSON: pass the text through rather than losing it.
+      return body;
+    }
+  }
+
+  void _debug(String message) {
+    assert(() {
+      // ignore: avoid_print
+      print('[proactive] $message');
+      return true;
+    }());
+  }
+}
+
+/// T7/D3: the person sent a message somewhere — the scheduler should step back for a while.
+class ProactiveUserActivity {
+  const ProactiveUserActivity({MethodChannel? methods}) : _methods = methods ?? const MethodChannel('dsh/proactive');
+
+  final MethodChannel _methods;
+
+  Future<void> notify() async {
+    try {
+      await _methods.invokeMethod<void>('userActivity');
+    } on PlatformException {
+      // Nothing to recover: the scheduler simply keeps its current plan.
+    }
+  }
+}
